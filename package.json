{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run site:prepare && vite",
    "build": "bun run site:prepare && vite build",
    "test:site": "bun test site/src/scryfallCache.test.ts",
    "typecheck": "tsc --noEmit",
    "deck:tokens": "bun .agents/skills/simulate-table/scripts/fetch-deck-tokens.ts",
    "table:deal": "bun .agents/skills/simulate-table/scripts/deal-table.ts",
    "table:continue": "bun .agents/skills/simulate-table/scripts/continue-table.ts",
    "table:review": "python3 .agents/skills/review-table/scripts/summarize_replays.py",
    "table:render": "python3 .agents/skills/render-table-replay/scripts/render_replay.py",
    "table:pages": "python3 .agents/skills/render-table-replay/scripts/build_pages.py",
    "table:live": "python3 .agents/skills/live-table/scripts/encode_live.py",
    "site:prepare": "bun run table:render && bun run table:pages"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
