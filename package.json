{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run site:prepare && vite",
    "build": "bun run site:prepare && vite build",
    "test:site": "bun test site/src/scryfallCache.test.ts site/src/liveCompact.test.ts site/src/cards.test.ts site/src/liveConduit.test.ts site/src/liveCodec.test.ts",
    "typecheck": "tsc --noEmit",
    "deck:tokens": "bun .agents/skills/simulate-table/scripts/fetch-deck-tokens.ts",
    "table:deal": "bun .agents/skills/simulate-table/scripts/deal-table.ts",
    "table:continue": "bun .agents/skills/simulate-table/scripts/continue-table.ts",
    "table:packet": "bun .agents/skills/simulate-table/scripts/seat-packet.ts",
    "test:table-packet": "bun test ./.agents/skills/simulate-table/scripts/seat-packet.test.ts",
    "table:review": "python3 .agents/skills/review-table/scripts/summarize_replays.py",
    "table:render": "python3 .agents/skills/render-table-replay/scripts/render_replay.py",
    "table:pages": "python3 .agents/skills/render-table-replay/scripts/build_pages.py",
    "table:live": "python3 .agents/skills/live-table/scripts/encode_live.py",
    "table:run": "bun live-runner/src/cli.ts",
    "table:run:bg": "bun live-runner/src/cli.ts",
    "test:live-runner": "bun test live-runner",
    "test:rules": "bun test rules-engine",
    "typecheck:live-runner": "tsc --ignoreConfig --noEmit --strict --moduleResolution Bundler --module ESNext --target ES2022 --types bun live-runner/src/*.ts",
    "table:decks": "python3 .agents/skills/live-table/scripts/publish_deck_indexes.py",
    "site:prepare": "bun run table:render && bun run table:pages && bun run table:decks"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
